# Cấu hình Backend (FastAPI + SQLite)
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./library.db

# Cấu hình Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Cấu hình Google AI (Gemini) - chỉ dùng giá trị giả trong .env.example
GEMINI_API_KEY=your_gemini_api_key_placeholder_here
GEMINI_MODEL=gemini-1.5-flash
